# catmap · 数据目录列语义推断与重复资产推荐
COMPOSE_PROJECT_NAME=catmap

# PostgreSQL 16
DB_NAME=catmap
DB_USER=catmap
DB_PASSWORD=catmap_pwd_2026

# JWT
JWT_SECRET=catmap-jwt-secret-change-me-2026-11
ACCESS_TOKEN_MINUTES=120

# 端口
FRONTEND_PORT=18229
BACKEND_PORT=19229
DB_PORT=17729

# 运行时
REDIS_URL=redis://redis:6379/0
SAMPLE_SCHEMA=sample
EXPORT_DIR=/data/exports
SEED_DEMO=true
INFERENCE_SAMPLE_LIMIT=200
SIMILARITY_TOP_N=6
SIMILARITY_MIN_SCORE=0.45

# 限流 / 配额
RATE_LIMIT_PER_MINUTE=240
QUOTA_ADMIN=5000
QUOTA_ANALYST=2500
QUOTA_VIEWER=1200
